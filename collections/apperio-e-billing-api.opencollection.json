      "info": {
        "name": "E-billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the invoice details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.apperio.com/api/v1/ebilling/invoices/:invoice-id/",
            "params": [
              {
                "name": "invoice-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Capabilities: BUSINESS, LAW_FIRM\n"
        },
        {
          "info": {
            "name": "Change invoice status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.apperio.com/api/v1/ebilling/invoices/:invoice-id/status/",
            "params": [
              {
                "name": "invoice-id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Capabilities: BUSINESS, LAW_FIRM\n"
        },
        {
          "info": {
            "name": "Get information about the invoice's approval workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.apperio.com/api/v1/ebilling/invoices/:invoice-id/approval-workflow/",
