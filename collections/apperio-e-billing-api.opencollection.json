          "docs": "Capabilities: BUSINESS\n"
        },
        {
          "info": {
            "name": "Approve the invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.apperio.com/api/v1/ebilling/invoices/:invoice-id/approval-state/:invoice-approval-state-id/approve/",
            "params": [
              {
                "name": "invoice-id",
                "value": "",
                "type": "path"
              },
              {
                "name": "invoice-approval-state-id",
                "value": "",
