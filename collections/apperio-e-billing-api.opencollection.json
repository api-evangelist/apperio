              }
            ]
          },
          "docs": "Capabilities: BUSINESS\n"
        },
        {
          "info": {
            "name": "Reject the invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.apperio.com/api/v1/ebilling/invoices/:invoice-id/approval-state/:invoice-approval-state-id/reject/",
            "params": [
              {
                "name": "invoice-id",
                "value": "",
